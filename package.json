{
  "name": "lasik-journey",
  "version": "1.0.0",
  "description": "LASIK Journey App - Marano Eye Care",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node fix_index.js && node inject_education.js && node inject_marano.js && node inject_contact_form.js && node inject_laser_animation.js && node inject_journey_mobile.js",
    "build": "npm run prebuild && vite build",
    "start": "npm run build && electron .",
    "package": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.marano.lasik",
    "productName": "LASIK Journey",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "shortcutName": "LASIK Journey"
    },
    "files": [
      "main.js",
      "dist/**/*"
    ]
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.475.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^6.1.0"
  }
}
